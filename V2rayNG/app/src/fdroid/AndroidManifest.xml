<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Enables exact execution of JSON `_comment` expiry when Android grants exact-alarm access. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- MobileTina does not expose launcher shortcuts or the legacy home-screen widget. -->
    <application>
        <activity
            android:name=".ui.main.MainActivity"
            tools:node="merge">
            <meta-data
                android:name="android.app.shortcuts"
                tools:node="remove" />
        </activity>

        <receiver
            android:name=".receiver.WidgetProvider"
            tools:node="remove" />
    </application>
</manifest>
